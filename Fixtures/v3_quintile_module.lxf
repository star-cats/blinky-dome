    "h4chan": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 511,
      "label": "H4 channel",
      "description": "Start channel for harness 4, within its start universe"
    },
    "t01rot": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2,
      "label": "T1 rotation",
      "description": "T1 is harness 1 position 1, dome face 1. Which corner its run of LEDs starts at, in thirds of a turn (0, 1, 2)"
    },
    "t01rev": {
      "type": "boolean",
      "default": false,
      "label": "T1 reverse",
      "description": "T1 is harness 1 position 1, dome face 1. Feed the run from its far end, so it walks the triangle the other way round"
    },
    "t02rot": {
