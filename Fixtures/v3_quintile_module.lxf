    "t13rot": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2,
      "label": "T13 rotation",
      "description": "H1 P1 triangle 13: which corner the run of LEDs starts at, in thirds of a turn (0, 1, 2)"
    },
    "t13rev": {
      "type": "boolean",
      "default": false,
