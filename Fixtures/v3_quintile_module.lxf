    "t01rot": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2,
      "label": "T1 rotation",
      "description": "T1 is harness 1 position 1, dome face 1. Which corner its run of LEDs starts at, in thirds of a turn (0, 1, 2)"
    },
