{
  "label": "V3 Quintile Module",
  "tags": [
    "dome",
    "geodesic",
    "v3",
    "quintile",
    "module"
  ],
  "parameters": {
    "proto": {
      "type": "string",
      "default": "artnet",
      "options": [
        "artnet",
        "sacn"
      ],
      "label": "Protocol",
      "description": "Output protocol. Both options address as universe + channel."
    },
    "ip": {
      "type": "string",
      "default": "192.168.1.60",
      "label": "Controller IP",
      "description": "Static IP of this module's pixel controller"
    },
    "pscale": {
      "type": "float",
      "default": 1.0,
      "min": 1.0,
      "max": 1000.0,
      "label": "Point scale",
      "description": "Preview dot size multiplier. LX does not scale point size by the fixture's Scale, so set this to match Scale: 10 in the camp projects, 1 at native metres."
    },
    "h1univ": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32767,
      "label": "H1 universe",
      "description": "Start universe for harness 1"
    },
    "h2univ": {
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 32767,
      "label": "H2 universe",
      "description": "Start universe for harness 2"
    },
    "h3univ": {
      "type": "int",
      "default": 2,
      "min": 0,
      "max": 32767,
      "label": "H3 universe",
      "description": "Start universe for harness 3"
    },
    "h4univ": {
      "type": "int",
      "default": 3,
      "min": 0,
      "max": 32767,
      "label": "H4 universe",
      "description": "Start universe for harness 4"
    },
    "h1chan": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 511,
      "label": "H1 channel",
      "description": "Start channel for harness 1, within its start universe"
    },
    "h2chan": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 511,
      "label": "H2 channel",
      "description": "Start channel for harness 2, within its start universe"
    },
    "h3chan": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 511,
      "label": "H3 channel",
      "description": "Start channel for harness 3, within its start universe"
