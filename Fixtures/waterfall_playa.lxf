  "meta": {
    "coordinate_system": "Y-up right-handed, metres, origin at the centre of the curtain on the ground line; the projects place this at scale 10",
    "groups": 9,
    "group_letters": "A, B, C, D, E, F, G, H, I",
    "strips_per_group": 4,
    "group_pattern_px": "315, 360, 315, 360",
    "strips": 36,
    "total_pixels": 12150,
    "pixels_per_metre": 60.0,
    "strip_lengths_m": "315 px = 5.25 m, 360 px = 6 m",
    "strip_spacing_in": 5.0,
    "strip_spacing": "the $spacing parameter, in inches; x is an expression so it re-lays live, and a negative value mirrors the curtain end for end",
    "port_direction": "port 1 on +X, counting toward -X at positive spacing",
    "curtain_width_m": 4.445,
    "alignment": "top-aligned; the two strip lengths differ by 0.75 m",
    "wiring": "each strip runs bottom to top; pixel 0 is the lowest LED",
    "reverse": "the single $rev parameter flips the data direction of all 36 strips",
    "trim": "each strip has its own vertical trim in metres, applied to geometry only",
    "addressing": "3 channels per pixel, 170 pixels (510 channels) per universe, one continuous channel space from universe 1 channel 0",
    "calibration_source": "waterfall-calibration.md, ports 1-36",
    "universes_used": "1-72"
  },
