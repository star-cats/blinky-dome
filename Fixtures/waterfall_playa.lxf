{
  "label": "Waterfall Playa",
  "tags": [
    "waterfall",
    "playa",
    "curtain"
  ],
  "parameters": {
    "proto": {
      "type": "string",
      "default": "artnet",
      "options": [
        "artnet",
        "sacn"
      ],
      "label": "Protocol",
      "description": "Output protocol. Both options address as universe + channel."
    },
    "ip": {
      "type": "string",
      "default": "192.168.44.50",
      "label": "Controller IP",
      "description": "Static IP of the waterfall's pixel controller -- one for all 36 strips"
    },
    "rev": {
      "type": "boolean",
      "default": false,
      "label": "Reverse waterfall",
      "description": "Flip the data direction of every strip at once. The strips are wired from the bottom upward, so leave this off unless the whole curtain runs the wrong way"
    },
    "s01univ": {
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 32767,
      "label": "G1 S1 universe",
      "description": "Start universe for G1 S1, port 1, 315 px"
    },
    "s01chan": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 511,
      "label": "G1 S1 channel",
      "description": "Start channel for G1 S1, port 1, 315 px, within its start universe"
    },
    "s01trim": {
      "type": "float",
      "default": 0.0,
      "min": -5.0,
      "max": 5.0,
      "label": "G1 S1 trim",
      "description": "Vertical trim for G1 S1, port 1, 315 px, in metres. Moves the strip's geometry up (+) or down (-); does not touch its addressing"
    },
    "s02univ": {
      "type": "int",
      "default": 2,
      "min": 0,
      "max": 32767,
