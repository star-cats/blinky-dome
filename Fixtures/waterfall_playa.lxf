{
  "label": "Waterfall Playa",
  "tags": [
    "waterfall",
    "playa",
    "curtain"
  ],
  "parameters": {
    "proto": {
      "type": "string",
      "default": "artnet",
      "options": [
        "artnet",
        "sacn"
      ],
      "label": "Protocol",
      "description": "Output protocol. Both options address as universe + channel."
    },
    "ip": {
      "type": "string",
      "default": "192.168.44.50",
      "label": "Controller IP",
      "description": "Static IP of the waterfall's pixel controller -- one for all 36 strips"
    },
    "spacing": {
      "type": "float",
      "default": 5.0,
      "min": -120.0,
      "max": 120.0,
      "label": "Strip spacing",
      "description": "Horizontal distance between adjacent strips, in inches. The curtain stays centred on the fixture's origin as this opens and closes. Negative flips the curtain end for end, so port 1 lands on the other side"
    },
    "rev": {
      "type": "boolean",
      "default": false,
      "label": "Reverse waterfall",
      "description": "Flip the data direction of every strip at once. The strips are wired from the bottom upward, so leave this off unless the whole curtain runs the wrong way"
    },
    "a1univ": {
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 32767,
      "label": "A1 univ",
      "description": "Start universe for A1, port 1, 315 px"
    },
    "a2univ": {
      "type": "int",
      "default": 2,
      "min": 0,
      "max": 32767,
      "label": "A2 univ",
      "description": "Start universe for A2, port 2, 360 px"
    },
    "a3univ": {
      "type": "int",
      "default": 4,
      "min": 0,
      "max": 32767,
      "label": "A3 univ",
      "description": "Start universe for A3, port 3, 315 px"
    },
    "a4univ": {
      "type": "int",
      "default": 6,
      "min": 0,
      "max": 32767,
      "label": "A4 univ",
      "description": "Start universe for A4, port 4, 360 px"
    },
    "a1chan": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 511,
      "label": "A1 chan",
      "description": "Start channel for A1, port 1, 315 px, within its start universe"
    },
    "a2chan": {
      "type": "int",
      "default": 435,
      "min": 0,
      "max": 511,
      "label": "A2 chan",
      "description": "Start channel for A2, port 2, 360 px, within its start universe"
    },
    "a3chan": {
      "type": "int",
      "default": 495,
      "min": 0,
      "max": 511,
      "label": "A3 chan",
      "description": "Start channel for A3, port 3, 315 px, within its start universe"
    },
    "a4chan": {
      "type": "int",
      "default": 420,
      "min": 0,
      "max": 511,
      "label": "A4 chan",
      "description": "Start channel for A4, port 4, 360 px, within its start universe"
    },
    "a1trim": {
      "type": "float",
      "default": 0.0,
      "min": -5.0,
      "max": 5.0,
      "label": "A1 trim",
      "description": "Vertical trim for A1, port 1, 315 px, in metres. Moves the strip's geometry up (+) or down (-); does not touch its addressing"
    },
    "a2trim": {
