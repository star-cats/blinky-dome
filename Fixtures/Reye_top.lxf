      "label": "Reye top On",
      "type": "boolean",
      "default": false,
      "description": "Whether output to Reye top is enabled"
    },
    "host01": {
      "label": "Reye top Host",
      "type": "string",
      "default": "192.168.1.158",
      "description": "Output host for Reye top"
    }
  },
  "components": [
    {
      "label": "Reye top",
      "tags": [
        "small_eye"
      ],
      "type": "arc",
