      "z": -10.0,
      "yaw": 180.0,
      "pitch": 0.0,
      "roll": 140.0,
      "numPoints": 144,
      "radius": 5.0,
      "degrees": 120.0,
      "mode": "origin",
      "output": {
        "enabled": "$output01",
        "host": "$host01",
