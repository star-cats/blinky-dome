{
  "label": "Ben Eyes",
  "metadata": {
    "source": "Projects/BenStartingPoint.lxp, fixtures \"Leye top/Bottom\" and \"Reye top/Bottom\"",
    "coordinate_system": "Y-up right-handed, origin at the project origin, units are project scene units (not metres)",
    "scene_units": "arc radius 5 units; the project is built at 10 units per metre, so each eye is a 0.5 m radius ring",
    "instantiate_at": "x=0 y=0 z=0, scale=1.0 -- the components carry their absolute project positions, so any other placement moves the eyes off Ben's layout",
    "geometry": "each eye is two 120-degree arcs sharing a centre; the bottom arc is pitched 180 to sweep the other way",
    "artnet": "one controller per eye, 144 px = 432 channels per arc; the top arc starts at channel 0 and the bottom at 432, so each eye spills past the 512-channel universe boundary. Carried over from the project as-is.",
    "note": "Reye top and Reye Bottom were toggled off (enabled=false) in the project, Leye top and Leye Bottom were on. That is per-instance runtime state, not geometry, so it is not encoded here. Setting component \"enabled\": false instead would drop their points from the model entirely.",
    "total_arcs": 4,
    "total_pixels": 576
  },
